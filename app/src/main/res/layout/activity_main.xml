<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.kioskcamera.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <com.kioskcamera.FocusIndicatorView
        android:id="@+id/focusIndicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Countdown overlay -->
    <TextView
        android:id="@+id/countdownText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="120sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="8"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <!-- Top controls bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#60000000">

        <!-- Flash toggle -->
        <TextView
            android:id="@+id/flashButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLASH OFF"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- HDR toggle -->
        <TextView
            android:id="@+id/hdrButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HDR"
            android:textColor="#888888"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Timer toggle -->
        <TextView
            android:id="@+id/timerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIMER OFF"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Camera switch -->
        <TextView
            android:id="@+id/switchCameraButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLIP"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Exposure compensation slider (vertical, right side) -->
    <SeekBar
        android:id="@+id/exposureSlider"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:rotation="270"
        android:thumb="@android:drawable/btn_radio"
        android:progressTint="@android:color/white"
        android:thumbTint="@android:color/white"
        android:visibility="gone" />

    <TextView
        android:id="@+id/exposureText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="200dp"
        android:padding="4dp"
        android:background="#80000000"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Zoom level indicator -->
    <TextView
        android:id="@+id/zoomText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="140dp"
        android:padding="6dp"
        android:background="#80000000"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Status text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:padding="8dp"
        android:background="#80000000"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Recording timer -->
    <TextView
        android:id="@+id/recordingTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="160dp"
        android:padding="6dp"
        android:background="#80000000"
        android:textColor="#FF4444"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Mode toggle (PHOTO / VIDEO) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        android:orientation="horizontal"
        android:background="#60000000"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/photoModeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_photo_camera"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:tint="#FFD700"
            android:contentDescription="Photo mode" />

        <ImageButton
            android:id="@+id/videoModeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_videocam"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:tint="@android:color/white"
            android:contentDescription="Video mode" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="48dp"
        android:paddingHorizontal="32dp">

        <!-- Gallery button -->
        <ImageButton
            android:id="@+id/galleryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="0"
            android:background="@drawable/gallery_button_bg"
            android:scaleType="centerCrop"
            android:contentDescription="View photos" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Shutter / Record button -->
        <ImageButton
            android:id="@+id/captureButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_weight="0"
            android:background="@drawable/shutter_button"
            android:contentDescription="Take photo"
            android:src="@android:color/transparent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Placeholder for symmetry -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="0" />

    </LinearLayout>

</FrameLayout>
